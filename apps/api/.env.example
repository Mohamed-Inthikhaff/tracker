# Local API env (do not commit real secrets)
JWT_SECRET=dev-only-change-me
# Dev-only HS256 fallback for curl/scripts. Leave false in running apps.
ALLOW_DEV_JWT=false
PORT=3001

# Auth0 API resource (JWKS RS256). Product login is Auth0 only.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://expense-tracker-api


DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=expense_tracker
# Local schema sync only — prefer migrations outside local (impl plan §8.2)
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Classification (Gemini — FR-CAT-003+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CLASSIFICATION_HIGH_CONFIDENCE=0.85
CLASSIFICATION_FEW_SHOT_LIMIT=8

# Billing (Stripe — FR-BILL-*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
FREE_TIER_MONTHLY_TRANSACTIONS=100
FREE_TIER_MONTHLY_OCR=0
PRO_TIER_MONTHLY_OCR=200
